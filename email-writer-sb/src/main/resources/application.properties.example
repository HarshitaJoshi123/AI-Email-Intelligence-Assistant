spring.application.name=email-writer-sb

# ================================
# Gemini
# ================================

gemini.api.url=YOUR_GEMINI_API_URL
gemini.api.key=YOUR_GEMINI_API_KEY


# ================================
# PostgreSQL
# ================================

spring.datasource.url=YOUR_DATABASE_URL
spring.datasource.username=YOUR_POSTGRES_USERNAME
spring.datasource.password=YOUR_POSTGRES_PASSWORD

# Flyway database migrations
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# Flyway owns the schema
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true


# ================================
# Telegram alerts
# ================================
# One bot token is shared by the app. The destination chat id is
# now per-user (users.telegram_chat_id), set via
# PUT /api/email/telegram/settings, not a global property.

telegram.bot.token=YOUR_TELEGRAM_BOT_TOKEN


# ================================
# Error Details
# ================================

# Kept "never" so internal exception details are not leaked to
# API clients. The GlobalExceptionHandler returns clean,
# user-friendly error responses instead.
server.error.include-message=never
server.error.include-binding-errors=never
